---
import Hero from "../components/luisita/en/HeroEn.astro";
import AboutUs from "../components/luisita/en/AboutUsEn.astro";
import Habitaciones from "../components/luisita/en/HabitacionesEn.astro";
import Restaurante from "../components/luisita/en/RestauranteEn.astro";
import Instalaciones from "../components/luisita/en/InstalacionesEn.astro";
import Experiencias from "../components/luisita/en/ExperienciasEn.astro";
import Banner1 from "../components/luisita/en/Banner1En.astro";
import Contacto from "../components/luisita/en/ContactoEn.astro";
import Header from "../components/luisita/en/HeaderluisitaEn.astro";
import Footer from "../components/Footer.astro";
import ToursTeaser from "../components/en/ToursTeaserEN.astro";
import WhatsAppButton from "../components/en/WhatsAppButtonEn.astro";
import "../styles/global.css";
import SEOHead from "../components/seo/SEOHead.astro";
import { hotel } from "../lib/schema";

const jsonLd = hotel({
  name: "Hotel Cascada de Fuego",
  path: "/cascadadefuego",
  description: "Hotel Cascada de Fuego and Abuela Luisita Restaurant in La Fortuna: premium rooms with jacuzzi, Costa Rican flavor, close to Arenal Volcano.",
});
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead
      lang="en"
      title="Hotel Cascada de Fuego | Abuela Luisita, La Fortuna"
      description="Hotel Cascada de Fuego and Abuela Luisita Restaurant in La Fortuna: premium rooms with jacuzzi, Costa Rican flavor, close to Arenal Volcano."
      alternate="/cascadadefuego"
      jsonLd={jsonLd}
    />
  </head>

  <body class="bg-white text-gray-900">
    <Header />
    <Hero />
    <AboutUs />
    <Habitaciones />
    <Restaurante />
    <Instalaciones />
    <Banner1 />
    <Contacto />
    <ToursTeaser />
    <Footer lang="en" />
    <WhatsAppButton />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
