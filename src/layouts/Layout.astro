---
import SEOHead from "../components/seo/SEOHead.astro";
import type { Props as SEOProps } from "../components/seo/SEOHead.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import WhatsAppButtonEn from "../components/en/WhatsAppButtonEn.astro";
import "../styles/global.css";

export type Props = SEOProps;
const { lang = "es" } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <SEOHead {...Astro.props} />
  </head>
  <body>
    <slot />
    {lang === "en" ? <WhatsAppButtonEn /> : <WhatsAppButton />}
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
