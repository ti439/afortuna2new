---
import Tours from "../components/en/tours/ToursEn.astro";
import Header from "../components/en/HeaderPagesEn.astro";
import Footer from "../components/Footer.astro";
import WhatsAppButton from "../components/en/WhatsAppButtonEn.astro";

import "../styles/global.css";
import SEOHead from "../components/seo/SEOHead.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead
      lang="en"
      title="La Fortuna & Arenal Volcano Tours | Afortunados"
      description="Canopy, rafting, horseback riding, hanging bridges and coffee tours in La Fortuna. Book guided Arenal Volcano tours with Afortunados."
      alternate="/tours"
    />
  </head>

  <body class="flex flex-col min-h-screen bg-white text-gray-900">
    <Header esHref="/tours" />
    <div class="flex-1">
      <Tours />
    </div>
    <div>
      <Footer lang="en" />
    </div>
    <WhatsAppButton />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
