---
import Hero from "../components/luisita/Hero.astro";
import AboutUs from "../components/luisita/AboutUs.astro";
import Habitaciones from "../components/luisita/Habitaciones.astro";
import Restaurante from "../components/luisita/Restaurante.astro";
import Instalaciones from "../components/luisita/Instalaciones.astro";
import Experiecias from "../components/luisita/Experiencias.astro";
import Banner1 from "../components/luisita/Banner1.astro";
import Contacto from "../components/luisita/Contacto.astro";
import Header from '../components/luisita/Headerluisita.astro';
import Footer from '../components/Footer.astro';
import ToursTeaser from "../components/ToursTeaser.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";

import "../styles/global.css";
import SEOHead from "../components/seo/SEOHead.astro";
import { hotel } from "../lib/schema";

const jsonLd = hotel({
  name: "Hotel Cascada de Fuego",
  path: "/cascadadefuego",
  description: "Hotel Cascada de Fuego y Restaurante Abuela Luisita en La Fortuna: habitaciones premium con jacuzzi, sabor tico y cercanía al Volcán Arenal.",
});
---

<!doctype html>
<html lang="es">
  <head>
    <SEOHead
      lang="es"
      title="Hotel Cascada de Fuego | Abuela Luisita, La Fortuna"
      description="Hotel Cascada de Fuego y Restaurante Abuela Luisita en La Fortuna: habitaciones premium con jacuzzi, sabor tico y cercanía al Volcán Arenal."
      alternate="/en/cascadadefuego"
      jsonLd={jsonLd}
    />
  </head>

  <body class="bg-white text-gray-900">
    <Header />
    <Hero />
    <AboutUs />
    <Habitaciones />
    <Restaurante />
    <Instalaciones /> 
    <Banner1 />
    <Contacto /> 
    <ToursTeaser />
    <Footer />
    <WhatsAppButton />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
