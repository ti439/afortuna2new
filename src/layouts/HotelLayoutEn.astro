---
import Hero from "../components/suenodorado/en/HeroEn.astro";
import AboutUs from "../components/suenodorado/en/AboutUsEn.astro";
import Habitaciones from "../components/suenodorado/en/HabitacionesEn.astro";
import Instalaciones from "../components/suenodorado/en/InstalacionesEn.astro";
import Experiencias from "../components/suenodorado/en/ExperienciasEn.astro";
import Contacto from "../components/suenodorado/en/ContactoEn.astro";
import Beneficios from "../components/suenodorado/en/BeneficiosEn.astro";
import Header from "../components/suenodorado/en/HeaderSuenoEn.astro";
import OtrosHospedajesBanner from "../components/suenodorado/en/OtrosHospedajesBannerEn.astro";
import Footer from "../components/Footer.astro";
import ToursTeaser from "../components/en/ToursTeaserEN.astro";
import WhatsAppButton from "../components/en/WhatsAppButtonEn.astro";
import "../styles/global.css";
import SEOHead from "../components/seo/SEOHead.astro";
import { hotel } from "../lib/schema";

const jsonLd = hotel({
  name: "Hotel Sueño Dorado",
  path: "/suenodorado",
  description: "Hotel Sueño Dorado in La Fortuna: rooms with Arenal Volcano views, hot spring pools and breakfast included. Book direct for the best rate.",
});
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead
      lang="en"
      title="Hotel Sueño Dorado | Arenal Volcano Views, La Fortuna"
      description="Hotel Sueño Dorado in La Fortuna: rooms with Arenal Volcano views, hot spring pools and breakfast included. Book direct for the best rate."
      alternate="/suenodorado"
      jsonLd={jsonLd}
    />
  </head>

  <body class="bg-white text-gray-900">
    <Header />
    <Hero />
    <AboutUs />
    <Habitaciones />
    <Instalaciones />
    <Experiencias />
    <OtrosHospedajesBanner />
    <ToursTeaser />
    <Beneficios />
    <Contacto />
    <Footer lang="en" />
    <WhatsAppButton />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
