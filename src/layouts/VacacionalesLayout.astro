---
import Villas from "../components/vacacionales/Villas.astro";
import Header from '../components/HeaderPages.astro';
import Footer from '../components/Footer.astro';
import ToursTeaser from "../components/ToursTeaser.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";

import "../styles/global.css";
import SEOHead from "../components/seo/SEOHead.astro";
---

<!doctype html>
<html lang="es">
  <head>
    <SEOHead
      lang="es"
      title="Villas y hospedajes en La Fortuna | Afortunados"
      description="Villas, hoteles y casas vacacionales en La Fortuna, Costa Rica: Eco Villa, Sueño Dorado, Monte Real y más, cerca del Volcán Arenal."
      alternate="/en/vacacionales"
    />
  </head>

  <body class="flex flex-col min-h-screen bg-white text-gray-900">
      <Header enHref="/en/vacacionales" />
      <div class="flex-1">
    <Villas/>
      </div>
      <div>
  <ToursTeaser/>
  <Footer />
  <WhatsAppButton />
      </div>

  
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
