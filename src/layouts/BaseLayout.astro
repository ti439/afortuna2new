---
import "../styles/global.css";
import SEOHead from "../components/seo/SEOHead.astro";
import type { Props as SEOProps } from "../components/seo/SEOHead.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import WhatsAppButtonEn from "../components/en/WhatsAppButtonEn.astro";

export type Props = SEOProps;
const { lang = "es" } = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <SEOHead {...Astro.props} />

    {/* Fuentes: serif elegante para display + sans refinada para texto */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&family=Manrope:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <slot name="head" />
    <script is:inline>
      // Oculta el texto del hero hasta que GSAP lo anime; nunca más de 2.5 s si el JS falla
      if (matchMedia("(prefers-reduced-motion: no-preference)").matches) {
        document.documentElement.classList.add("anim-hero");
        setTimeout(function () { document.documentElement.classList.remove("anim-hero"); }, 2500);
      }
    </script>
  </head>
  <body class="bg-cream text-ink font-body antialiased">
    <slot />
    {lang === "en" ? <WhatsAppButtonEn /> : <WhatsAppButton />}
    <script>
      import "../scripts/animations";
    </script>
  </body>
</html>

<style is:global>
  :root {
    /* Paleta eco-lujo */
    --color-cream: #f5f2e8;
    --color-cream-warm: #ede8d6;
    --color-ink: #1a1f1a;
    --color-ink-soft: #4a5048;
    --color-ink-muted: #5a6157;

    --color-forest: #1f4029;
    --color-forest-deep: #142a1c;
    --color-forest-bright: #2d6240;

    --color-gold: #b8954a;
    --color-gold-light: #d4b574;
    --color-gold-pale: #f0e4c2;

    --shadow-soft: 0 1px 2px rgba(20, 25, 20, 0.04),
                   0 8px 24px rgba(20, 25, 20, 0.06);
    --shadow-elevated: 0 4px 12px rgba(20, 25, 20, 0.08),
                       0 24px 60px rgba(20, 25, 20, 0.12);
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 80px;
  }

  body {
    font-family: "Manrope", system-ui, sans-serif;
    font-feature-settings: "ss01", "cv11";
  }

  .font-display {
    font-family: "Fraunces", "Cormorant Garamond", Georgia, serif;
    font-feature-settings: "ss01";
  }

  /* Selección de texto on-brand */
  ::selection {
    background: var(--color-gold-pale);
    color: var(--color-forest-deep);
  }

  /* Focus visible accesible y elegante */
  :focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: 3px;
    border-radius: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }

  .anim-hero [data-hero-item] {
    visibility: hidden;
  }
</style>