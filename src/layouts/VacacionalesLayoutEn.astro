---
import Villas from "../components/vacacionales/en/VillasEn.astro";
import Header from "../components/en/HeaderPagesEn.astro";
import Footer from "../components/en/FooterEn.astro";
import ToursTeaser from "../components/en/ToursTeaserEN.astro";
import WhatsAppButton from "../components/en/WhatsAppButtonEn.astro";

import "../styles/global.css";
import SEOHead from "../components/seo/SEOHead.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead
      lang="en"
      title="Villas & Stays in La Fortuna | Afortunados"
      description="Villas, hotels and vacation rentals in La Fortuna, Costa Rica: Eco Villa, Sueño Dorado, Monte Real and more, near the Arenal Volcano."
      alternate="/vacacionales"
    />
  </head>

  <body class="flex flex-col min-h-screen bg-white text-gray-900">
    <Header esHref="/vacacionales" />
    <div class="flex-1">
      <Villas />
    </div>
    <div>
      <ToursTeaser />
      <Footer />
      <WhatsAppButton />
    </div>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
