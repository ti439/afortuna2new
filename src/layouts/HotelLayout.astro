---
import Hero from "../components/suenodorado/Hero.astro";
import AboutUs from "../components/suenodorado/AboutUs.astro";
import Habitaciones from "../components/suenodorado/Habitaciones.astro";
import Instalaciones from "../components/suenodorado/Instalaciones.astro";
import Experiecias from "../components/suenodorado/Experiencias.astro";
import Contacto from "../components/suenodorado/Contacto.astro";
import Beneficios from "../components/suenodorado/Beneficios.astro";
import Header from '../components/suenodorado/HeaderSueno.astro';
import OtrosHospedajesBanner from "../components/suenodorado/OtrosHospedajesBanner.astro";
import Footer from '../components/Footer.astro';
import ToursTeaser from "../components/ToursTeaser.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";

import "../styles/global.css";
import SEOHead from "../components/seo/SEOHead.astro";
import { hotel } from "../lib/schema";

const jsonLd = hotel({
  name: "Hotel Sueño Dorado",
  path: "/suenodorado",
  description: "Hotel Sueño Dorado en La Fortuna: habitaciones con vista al Volcán Arenal, piscinas termales y desayuno incluido. Reserva directa al mejor precio.",
});
---

<!doctype html>
<html lang="es">
  <head>
    <SEOHead
      lang="es"
      title="Hotel Sueño Dorado | Vista al Volcán Arenal, La Fortuna"
      description="Hotel Sueño Dorado en La Fortuna: habitaciones con vista al Volcán Arenal, piscinas termales y desayuno incluido. Reserva directa al mejor precio."
      alternate="/en/suenodorado"
      jsonLd={jsonLd}
    />
  </head>

  <body class="bg-white text-gray-900">
    <Header />
    <Hero />
    <AboutUs />
    <Habitaciones />
    <Instalaciones />
    <Experiecias />
    <OtrosHospedajesBanner />
    <ToursTeaser />
    <Beneficios />
    <Contacto />
    <Footer />
    <WhatsAppButton />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
