---
import Layout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/home/Hero.astro";
import Hospedajes from "../components/home/Hospedajes.astro";
import ToursTeaser from "../components/ToursTeaser.astro";
import GoogleReviews from "../components/home/GoogleReviews.astro";
import Nosotros from "../components/home/Nosotros.astro";
import FAQ from "../components/home/FAQ.astro";
import CTAFinal from "../components/home/CTAFinal.astro";
import { organization } from "../lib/schema";
---

<Layout
  lang="es"
  title="Afortunados | Hospedaje y tours en La Fortuna, Costa Rica"
  description="Hoteles con aguas termales, villas y tours frente al Volcán Arenal en La Fortuna, Costa Rica. 4.9 en Google. Reserva directo por WhatsApp."
  alternate="/en"
  jsonLd={organization}
>
  <Header />
  <main>
    <Hero lang="es" />
    <Hospedajes lang="es" />
    <ToursTeaser lang="es" />
    <GoogleReviews lang="es" />
    <Nosotros lang="es" />
    <FAQ lang="es" />
    <CTAFinal lang="es" />
  </main>
  <Footer />
</Layout>
