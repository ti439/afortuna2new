---
import Layout from "../layouts/BaseLayout.astro";
import villas from "../Data/villas_detalle.json";
import { gallery } from "../lib/images";
import VillaDetalle from "../components/vacacionales/VillaDetalle.astro";

const { id } = Astro.params;
const villa = villas.find((v) => v.id === id);

if (!villa) {
  throw new Error(`Villa no encontrada: ${id}`);
}

export async function getStaticPaths() {
  return villas.map((v) => ({
    params: { id: v.id }
  }));
}
const imagenes = await gallery(villa.imagenes);
---

<Layout
  lang="es"
  title={`${villa.titulo} | Afortunados`}
  description={villa.subtitulo}
  image={imagenes[0]?.src}
  alternate={`/en/${id}`}
  canonical={id === "sueno-dorado" ? "/suenodorado" : undefined}
>
  <VillaDetalle
    id={id}
    titulo={villa.titulo}
    subtitulo={villa.subtitulo}
    parrafoPrincipal={villa.parrafoPrincipal}
        imagenes={imagenes}
    secciones={villa.secciones}
    beneficios={villa.beneficios}
    habitaciones={villa.habitaciones}
    sustentabilidad={villa.sustentabilidad}
    cierre={villa.cierre}
    url={villa.url}
    precio={villa.precio ?? villa.price}
  />
</Layout>
