---
import Layout from "../../../layouts/BaseLayoutEn.astro";
import TourDetail from "../../../components/en/tours/[tour].astro";
import toursData from "../../../Data/tours_en.json";
import toursDetailData from "../../../Data/toursTotal_en.json";
import otherLangTours from "../../../Data/tours.json";
import { slugify } from "../../../lib/tours";
import { touristTrip } from "../../../lib/schema";

export async function getStaticPaths() {

  const toursBase = toursData.map((tour) => ({
    ...tour,
    slug: tour.slug ?? slugify(tour.nombre)
  }));

  const toursDetail = toursDetailData.map((tour) => ({
    ...tour,
    slug: tour.slug ?? slugify(tour.nombre)
  }));

  const buildTour = (slug) => {
    const base = toursBase.find((t) => t.slug === slug) ?? {};
    const detail = toursDetail.find((t) => t.slug === slug) ?? {};
    return { ...base, ...detail };
  };

  // tours.json y tours_en.json comparten el mismo orden: se emparejan por índice para el hreflang
  return toursBase.map((tour, i) => {
    const other = otherLangTours[i];
    const otherSlug = other ? other.slug ?? slugify(other.nombre) : undefined;
    return {
      params: { tour: tour.slug },
      props: {
        tour: buildTour(tour.slug),
        alternate: otherSlug ? `/tours/${otherSlug}` : undefined,
      },
    };
  });
}

const { tour, alternate } = Astro.props;
const description = tour.descripcionCorta ?? tour.descripcion;
const image = tour.imagenDetalle ?? tour.imagen;
---

<Layout
  lang="en"
  title={`${tour.nombre} | La Fortuna Tours`}
  description={description}
  image={image}
  alternate={alternate}
  jsonLd={touristTrip({ name: tour.nombre, path: Astro.url.pathname, description, image, price: tour.precio })}
>
  <TourDetail tour={tour} />
</Layout>
