---
import OptImage from "./OptImage.astro";
import { getTours } from "../lib/tours";

interface Props {
  lang?: "es" | "en";
}
const { lang = "es" } = Astro.props;
const en = lang === "en";

// Destacados por posición (tours.json y tours_en.json comparten orden): rafting, cabalgata al volcán, canopy
const FEATURED = [1, 3, 5];
const tours = getTours(lang);
const featured = FEATURED.map((i) => tours[i]).filter(Boolean);

const t = en
  ? {
      eyebrow: "Recommended experiences",
      title: "Tours around Arenal Volcano",
      lead: "Tours selected for quality, safety and local guides. Book direct and secure your spot.",
      all: "See all tours",
      from: "From",
      details: "View tour",
      book: "Book",
      message: (name: string) => `Hi Afortunados, I'd like to book the tour: ${name}`,
    }
  : {
      eyebrow: "Experiencias recomendadas",
      title: "Tours alrededor del Volcán Arenal",
      lead: "Tours seleccionados por calidad, seguridad y guía local. Reserva directo y asegura tu cupo.",
      all: "Ver todos los tours",
      from: "Desde",
      details: "Ver tour",
      book: "Reservar",
      message: (name: string) => `Hola Afortunados, quiero reservar el tour: ${name}`,
    };
---

<section class="bg-cream-warm px-5 py-20 text-ink sm:px-8 md:py-28">
  <div class="mx-auto max-w-6xl">
    <div data-anim="fade-up" class="mb-12 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl">
        <p class="mb-3 text-xs font-semibold uppercase tracking-[0.3em] text-gold-deep">{t.eyebrow}</p>
        <h2 class="font-display text-4xl font-light leading-tight text-forest-deep sm:text-5xl">{t.title}</h2>
        <p class="mt-4 text-lg leading-relaxed text-ink-soft">{t.lead}</p>
      </div>
      <a
        href={en ? "/en/tours" : "/tours"}
        class="inline-flex shrink-0 items-center justify-center gap-2 rounded-full border border-forest px-6 py-3 font-semibold text-forest transition hover:bg-forest hover:text-cream"
      >
        {t.all} →
      </a>
    </div>

    <div data-anim="stagger" class="grid gap-6 md:grid-cols-3">
      {featured.map((tour) => (
        <article class="flex flex-col overflow-hidden rounded-2xl bg-cream shadow-soft">
          <a href={tour.url} class="group relative block h-56 overflow-hidden">
            <OptImage
              src={tour.imagen}
              alt={tour.nombre}
              maxWidth={800}
              class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
            <span class="absolute left-4 top-4 rounded-full bg-cream/90 px-3 py-1 text-xs font-semibold text-forest">
              {tour.duracion}
            </span>
          </a>
          <div class="flex flex-1 flex-col p-6">
            <h3 class="font-display text-2xl text-forest-deep">
              <a href={tour.url} class="hover:underline">{tour.nombre}</a>
            </h3>
            <p class="mt-2 line-clamp-3 flex-1 text-sm leading-relaxed text-ink-soft">{tour.descripcion}</p>
            <p class="mt-4 text-sm text-ink-muted">
              {t.from} <span class="font-display text-2xl text-forest-deep">${tour.precio}</span> USD
            </p>
            <div class="mt-4 flex gap-3">
              <a href={tour.url} class="flex-1 rounded-full border border-forest px-4 py-2 text-center text-sm font-semibold text-forest transition hover:bg-forest hover:text-cream">
                {t.details}
              </a>
              <a
                href={`https://wa.me/50684597077?text=${encodeURIComponent(t.message(tour.nombre))}`}
                target="_blank"
                rel="noopener"
                onclick="return gtagSendEvent(this.href, this.target)"
                class="flex-1 rounded-full bg-forest px-4 py-2 text-center text-sm font-semibold text-cream transition hover:bg-forest-bright"
              >
                {t.book}
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
