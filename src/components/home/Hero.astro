---
import { Image } from "astro:assets";
import volcan from "../../assets/v2.jpg";
import google from "../../Data/google_reviews.json";

interface Props {
  lang?: "es" | "en";
}
const { lang = "es" } = Astro.props;

const t = {
  es: {
    eyebrow: "Un amigo en Costa Rica",
    title: "Hospedaje y tours en La Fortuna, frente al Volcán Arenal",
    lead: "Hoteles con aguas termales, villas privadas y tours con guías locales. Te ayudamos a reservar todo por WhatsApp.",
    whatsapp: "Cotizar por WhatsApp",
    stays: "Ver hospedajes",
    rating: `${google.rating} en Google · ${google.count} opiniones`,
    alt: "Vista aérea del Volcán Arenal y el bosque tropical de La Fortuna, Costa Rica",
    message: "Hola Afortunados, quiero cotizar mi viaje a La Fortuna",
  },
  en: {
    eyebrow: "A friend in Costa Rica",
    title: "Stays and tours in La Fortuna, facing Arenal Volcano",
    lead: "Hotels with hot springs, private villas and tours with local guides. We help you book everything on WhatsApp.",
    whatsapp: "Get a quote on WhatsApp",
    stays: "See places to stay",
    rating: `${google.rating} on Google · ${google.count} reviews`,
    alt: "Aerial view of Arenal Volcano and the La Fortuna rainforest, Costa Rica",
    message: "Hi Afortunados, I'd like a quote for my trip to La Fortuna",
  },
}[lang];

const whatsappUrl = `https://wa.me/50684597077?text=${encodeURIComponent(t.message)}`;
---

<section data-hero class="relative flex min-h-[100svh] items-end overflow-hidden bg-forest-deep text-cream">
  <Image
    src={volcan}
    alt={t.alt}
    widths={[828, 1280, 1600, 2200]}
    sizes="(orientation: portrait) 170vh, 100vw"
    format="webp"
    loading="eager"
    fetchpriority="high"
    data-hero-bg
    class="absolute inset-0 h-full w-full object-cover will-change-transform"
  />
  <!-- Velos: oscurecen el lado del texto para garantizar contraste sobre cualquier foto -->
  <div class="absolute inset-0 bg-gradient-to-t from-forest-deep via-forest-deep/60 to-forest-deep/25"></div>
  <div class="absolute inset-0 bg-gradient-to-r from-forest-deep/80 via-forest-deep/40 to-transparent"></div>

  <div class="relative z-10 mx-auto w-full max-w-6xl px-5 pb-16 pt-32 [text-shadow:0_1px_16px_rgba(10,20,14,0.45)] sm:px-8 md:pb-24">
    <p data-hero-item class="mb-4 text-xs font-semibold uppercase tracking-[0.3em] text-gold-light sm:text-sm">
      {t.eyebrow}
    </p>
    <h1 data-hero-item class="max-w-4xl font-display text-4xl font-light leading-[1.05] sm:text-6xl lg:text-7xl">
      {t.title}
    </h1>
    <p data-hero-item class="mt-6 max-w-xl text-base leading-relaxed text-cream/90 sm:text-lg">
      {t.lead}
    </p>

    <div data-hero-item class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4">
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener"
        onclick="return gtagSendEvent(this.href, this.target)"
        class="inline-flex items-center justify-center gap-2 rounded-full bg-gold px-7 py-4 text-base font-semibold text-forest-deep shadow-elevated transition hover:bg-gold-light"
      >
        <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.4 14.1c-.2.6-1.3 1.2-1.8 1.3-.5.1-1 .1-3.3-.8a10.9 10.9 0 0 1-4.3-3.8c-.4-.5-.9-1.6-.9-2.7a3 3 0 0 1 .9-2.1c.3-.3.6-.3.8-.3h.6c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.3.5-.4.4c-.1.2-.3.3-.1.6a8 8 0 0 0 1.5 1.8 7 7 0 0 0 2.1 1.3c.3.1.5.1.6-.1l.9-1c.2-.3.4-.2.6-.1l1.9.9c.3.1.5.2.5.3.1.2.1.7-.1 1.2Z"/></svg>
        {t.whatsapp}
      </a>
      <a
        href="#hospedajes"
        class="inline-flex items-center justify-center rounded-full border border-cream/60 px-7 py-4 text-base font-semibold text-cream transition hover:bg-cream hover:text-forest-deep"
      >
        {t.stays}
      </a>
    </div>

    <a data-hero-item href="#opiniones" class="mt-8 inline-flex items-center gap-2 text-sm text-cream/85 hover:text-cream">
      <span class="text-gold-light" aria-hidden="true">★★★★★</span>
      <span>{t.rating}</span>
    </a>
  </div>
</section>
