---
// Preguntas frecuentes. Las respuestas se basan en información ya publicada en el sitio;
// revisar con el equipo antes de agregar políticas nuevas (check-in, pagos, mascotas, cancelación).
interface Props {
  lang?: "es" | "en";
}
const { lang = "es" } = Astro.props;
const en = lang === "en";

const t = en
  ? {
      eyebrow: "Frequently asked questions",
      title: "Before you book",
      more: "Have another question?",
      cta: "Ask us on WhatsApp",
      faqs: [
        ["How do I book?", "Message us on WhatsApp at +506 8459 7077 and we'll help you quote your stay and tours. You can also book online from each hotel's page."],
        ["Where are you located?", "In La Fortuna de San Carlos, Alajuela, Costa Rica, close to Arenal Volcano."],
        ["Is hot springs access included?", "Yes. When you stay with us, a day pass to the Hotel Sueño Dorado hot springs is included."],
        ["Is breakfast included?", "At Hotel Sueño Dorado, yes: a buffet breakfast is included. For our other stays we'll confirm on WhatsApp depending on the option you choose."],
        ["Can you arrange tours and transfers?", "Yes. We coordinate tours with verified operators and local guides, and help you with schedules and transfers."],
        ["Is there WiFi and parking?", "Hotel Sueño Dorado has fiber-optic WiFi and private parking. Ask us about the other options."],
      ],
    }
  : {
      eyebrow: "Preguntas frecuentes",
      title: "Antes de reservar",
      more: "¿Tienes otra pregunta?",
      cta: "Pregúntanos por WhatsApp",
      faqs: [
        ["¿Cómo reservo?", "Escríbenos por WhatsApp al +506 8459 7077 y te ayudamos a cotizar hospedaje y tours. También puedes reservar en línea desde la página de cada hotel."],
        ["¿Dónde están ubicados?", "En La Fortuna de San Carlos, Alajuela, Costa Rica, cerca del Volcán Arenal."],
        ["¿Incluye acceso a aguas termales?", "Sí. Al hospedarte con nosotros se incluye el pase del día a las aguas termales del Hotel Sueño Dorado."],
        ["¿El desayuno está incluido?", "En el Hotel Sueño Dorado sí: desayuno buffet incluido. Para los demás hospedajes te confirmamos por WhatsApp según la opción que elijas."],
        ["¿Pueden organizar tours y traslados?", "Sí. Coordinamos tours con operadores verificados y guías locales, y te ayudamos con horarios y traslados."],
        ["¿Tienen WiFi y parqueo?", "El Hotel Sueño Dorado cuenta con WiFi de fibra óptica y parqueo privado. Consúltanos por las demás opciones."],
      ],
    };

const faqSchema =(faqs: string[][]) => ({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })),
});
---

<section id="preguntas" class="scroll-mt-20 bg-cream-warm px-5 py-20 sm:px-8 md:py-28">
  <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[2fr_3fr] lg:gap-16">
    <div data-anim="fade-up">
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.3em] text-gold-deep">{t.eyebrow}</p>
      <h2 class="font-display text-4xl font-light leading-tight text-forest-deep sm:text-5xl">{t.title}</h2>
      <p class="mt-6 text-ink-soft">{t.more}</p>
      <a
        href="https://wa.me/50684597077"
        target="_blank"
        rel="noopener"
        onclick="return gtagSendEvent(this.href, this.target)"
        class="mt-3 inline-flex font-semibold text-forest underline underline-offset-4 hover:text-forest-bright"
      >
        {t.cta} →
      </a>
    </div>

    <div data-anim="stagger" class="divide-y divide-ink/10 border-y border-ink/10">
      {t.faqs.map(([q, a]) => (
        <details class="group py-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-semibold text-forest-deep [&::-webkit-details-marker]:hidden">
            {q}
            <span aria-hidden="true" class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-forest/30 text-forest transition-transform group-open:rotate-45">+</span>
          </summary>
          <p class="mt-3 pr-12 leading-relaxed text-ink-soft">{a}</p>
        </details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema(t.faqs))} />
</section>
