---
// Calificación y reseñas reales de Google. Las reseñas se cargan en src/Data/google_reviews.json:
//   { "author": "Nombre", "rating": 5, "date": "2026-08", "text": "Texto de la reseña", "photo": "https://..." (opcional) }
import google from "../../Data/google_reviews.json";

interface Review {
  author: string;
  rating: number;
  date?: string;
  text: string;
  photo?: string;
}
interface Props {
  lang?: "es" | "en";
}
const { lang = "es" } = Astro.props;
const en = lang === "en";
const reviews = google.reviews as Review[];

const t = en
  ? {
      eyebrow: "Guest reviews",
      title: "What our guests say",
      reviews: `${google.count} Google reviews`,
      see: "Read reviews on Google",
      write: "Write a review",
      prev: "Previous review",
      next: "Next review",
      locale: "en-US",
    }
  : {
      eyebrow: "Opiniones de huéspedes",
      title: "Lo que dicen nuestros huéspedes",
      reviews: `${google.count} opiniones en Google`,
      see: "Ver opiniones en Google",
      write: "Dejar una opinión",
      prev: "Opinión anterior",
      next: "Opinión siguiente",
      locale: "es-CR",
    };

const formatDate = (date?: string) =>
  date ? new Date(`${date}-01T12:00:00`).toLocaleDateString(t.locale, { month: "long", year: "numeric" }) : "";
const stars = (n: number) => "★".repeat(Math.round(n)) + "☆".repeat(5 - Math.round(n));
---

<section id="opiniones" class="scroll-mt-20 bg-forest-deep px-5 py-20 text-cream sm:px-8 md:py-28">
  <div class="mx-auto max-w-6xl">
    <div data-anim="fade-up" class="grid items-center gap-10 md:grid-cols-[1fr_auto]">
      <div>
        <p class="mb-3 text-xs font-semibold uppercase tracking-[0.3em] text-gold-light">{t.eyebrow}</p>
        <h2 class="font-display text-4xl font-light leading-tight sm:text-5xl">{t.title}</h2>
      </div>

      <div class="flex items-center gap-5 rounded-2xl border border-cream/15 bg-cream/5 p-6">
        <svg aria-hidden="true" class="h-10 w-10 shrink-0" viewBox="0 0 48 48">
          <path fill="#FFC107" d="M43.6 20.1H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 13 4 4 13 4 24s9 20 20 20 20-9 20-20c0-1.3-.1-2.6-.4-3.9z"/>
          <path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/>
          <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2A11.9 11.9 0 0 1 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/>
          <path fill="#1976D2" d="M43.6 20.1H42V20H24v8h11.3a12 12 0 0 1-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.6-.4-3.9z"/>
        </svg>
        <div>
          <p class="flex items-baseline gap-2">
            <span class="font-display text-5xl leading-none">
              <span data-count={google.rating}>{google.rating.toLocaleString(t.locale)}</span>
            </span>
            <span class="text-cream/60">/ 5</span>
          </p>
          <p class="mt-1 text-gold-light" aria-hidden="true">★★★★★</p>
          <p class="text-sm text-cream/75">{t.reviews}</p>
        </div>
      </div>
    </div>

    {reviews.length > 0 && (
      <div class="relative mt-12" data-reviews-carousel>
        <ul
          data-track
          class="-mx-5 flex snap-x snap-mandatory gap-5 overflow-x-auto scroll-smooth px-5 pb-4 [scrollbar-width:none] sm:mx-0 sm:px-0 [&::-webkit-scrollbar]:hidden"
          aria-label={t.title}
        >
          {reviews.map((r) => (
            <li class="w-[85%] shrink-0 snap-start sm:w-[calc(50%-0.625rem)] lg:w-[calc(33.333%-0.834rem)]">
              <figure class="flex h-full flex-col rounded-2xl bg-cream p-6 text-ink shadow-soft">
                <p class="text-gold-deep" aria-label={`${r.rating}/5`}>{stars(r.rating)}</p>
                <blockquote class="mt-3 flex-1 text-base leading-relaxed text-ink-soft">“{r.text}”</blockquote>
                <figcaption class="mt-5 flex items-center gap-3 border-t border-ink/10 pt-4">
                  {r.photo ? (
                    <img src={r.photo} alt="" width="40" height="40" loading="lazy" class="h-10 w-10 rounded-full object-cover" referrerpolicy="no-referrer" />
                  ) : (
                    <span class="flex h-10 w-10 items-center justify-center rounded-full bg-forest font-semibold text-cream" aria-hidden="true">
                      {r.author.charAt(0)}
                    </span>
                  )}
                  <span>
                    <span class="block font-semibold text-forest-deep">{r.author}</span>
                    <span class="block text-xs text-ink-muted">Google · {formatDate(r.date)}</span>
                  </span>
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>

        <div class="mt-6 flex justify-end gap-3">
          <button type="button" data-prev aria-label={t.prev} class="flex h-11 w-11 items-center justify-center rounded-full border border-cream/30 transition hover:bg-cream hover:text-forest-deep disabled:opacity-30">
            <svg aria-hidden="true" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
          </button>
          <button type="button" data-next aria-label={t.next} class="flex h-11 w-11 items-center justify-center rounded-full border border-cream/30 transition hover:bg-cream hover:text-forest-deep disabled:opacity-30">
            <svg aria-hidden="true" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </button>
        </div>
      </div>
    )}

    <div class="mt-10 flex flex-col gap-3 sm:flex-row">
      <a
        href={google.profileUrl}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center justify-center rounded-full bg-cream px-6 py-3 font-semibold text-forest-deep transition hover:bg-gold-pale"
      >
        {t.see}
      </a>
      <a
        href={google.profileUrl}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center justify-center rounded-full border border-cream/40 px-6 py-3 font-semibold transition hover:bg-cream/10"
      >
        {t.write}
      </a>
    </div>
  </div>
</section>

<script>
  // Carrusel con scroll-snap: swipe nativo en móvil, flechas para escritorio
  document.querySelectorAll<HTMLElement>("[data-reviews-carousel]").forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>("[data-track]")!;
    const prev = carousel.querySelector<HTMLButtonElement>("[data-prev]")!;
    const next = carousel.querySelector<HTMLButtonElement>("[data-next]")!;
    const step = () => (track.firstElementChild as HTMLElement | null)?.offsetWidth ?? track.clientWidth;
    const update = () => {
      prev.disabled = track.scrollLeft <= 4;
      next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
    };
    prev.addEventListener("click", () => track.scrollBy({ left: -step(), behavior: "smooth" }));
    next.addEventListener("click", () => track.scrollBy({ left: step(), behavior: "smooth" }));
    track.addEventListener("scroll", update, { passive: true });
    update();
  });
</script>
