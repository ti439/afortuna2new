---
import OptImage from "../OptImage.astro";
import termales from "../../assets/termales.JPG";
import ecovilla from "../../assets/villas/IMG_1703.jpg";
import monteReal from "../../assets/monterealafuera.jpg";
import downtown from "../../assets/fondoprincipal.png";

interface Props {
  lang?: "es" | "en";
}
const { lang = "es" } = Astro.props;
const en = lang === "en";

const t = en
  ? {
      eyebrow: "Where to stay",
      title: "Our places to stay in La Fortuna",
      lead: "Hotels and villas run by our own team. Every stay includes a day pass to the Hotel Sueño Dorado hot springs.",
      cta: "View details",
      all: "See all options",
    }
  : {
      eyebrow: "Dónde hospedarte",
      title: "Nuestros hospedajes en La Fortuna",
      lead: "Hoteles y villas atendidos por nuestro propio equipo. Al hospedarte con nosotros se incluye el pase del día a las aguas termales del Hotel Sueño Dorado.",
      cta: "Ver detalles",
      all: "Ver todas las opciones",
    };

const prefix = en ? "/en" : "";
const hospedajes = [
  {
    name: "Hotel Sueño Dorado",
    tag: en ? "Hot springs" : "Aguas termales",
    text: en
      ? "Hot spring pools, breakfast included and views of Arenal Volcano."
      : "Piscinas termales, desayuno incluido y vista al Volcán Arenal.",
    image: termales,
    alt: en ? "Aerial view of the Hotel Sueño Dorado hot spring pools" : "Vista aérea de las piscinas termales del Hotel Sueño Dorado",
    href: `${prefix}/suenodorado`,
    featured: true,
  },
  {
    name: "Hotel Cascada de Fuego",
    tag: "Abuela Luisita",
    text: en
      ? "Premium rooms with jacuzzi and the Costa Rican flavor of Abuela Luisita restaurant."
      : "Habitaciones premium con jacuzzi y el sabor tico del Restaurante Abuela Luisita.",
    image: "https://cdn.arenalcloud.com/arenal-a65b6eb9-29d7-4dec-9784-b1b37ff7dfce-afortunados/POOL_YARD_eace1389.jpg",
    alt: en ? "Pool and gardens at Hotel Cascada de Fuego" : "Piscina y jardines del Hotel Cascada de Fuego",
    href: `${prefix}/cascadadefuego`,
  },
  {
    name: "Eco Village",
    tag: en ? "For couples" : "Para parejas",
    text: en
      ? "Intimate cabin with a private pool and valley views, for 2 guests."
      : "Cabaña íntima con piscina privada y vista al valle, para 2 personas.",
    image: ecovilla,
    alt: en ? "Eco Village terrace with mountain views" : "Terraza de Eco Village con vista a las montañas",
    href: en ? "/en/ecovilla" : "/ecovillage",
  },
  {
    name: "Hotel Monte Real",
    tag: en ? "30 rooms" : "30 habitaciones",
    text: en ? "Pool and tropical gardens in a great location in La Fortuna." : "Piscina y jardines tropicales en una magnífica ubicación en La Fortuna.",
    image: monteReal,
    alt: en ? "Hotel Monte Real exterior" : "Fachada del Hotel Monte Real",
    href: `${prefix}/monte-real`,
  },
  {
    name: "La Fortuna Downtown",
    tag: en ? "19 rooms" : "19 habitaciones",
    text: en ? "Boutique hotel in the heart of La Fortuna." : "Hotel boutique en el corazón de La Fortuna.",
    image: downtown,
    alt: en ? "Lit pool at La Fortuna Downtown Boutique Hotel" : "Piscina iluminada de La Fortuna Downtown Boutique Hotel",
    href: `${prefix}/lafortuna-downtown`,
  },
];
---

<section id="hospedajes" class="scroll-mt-20 bg-cream px-5 py-20 sm:px-8 md:py-28">
  <div class="mx-auto max-w-6xl">
    <div data-anim="fade-up" class="mb-12 max-w-2xl">
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.3em] text-gold-deep">{t.eyebrow}</p>
      <h2 class="font-display text-4xl font-light leading-tight text-forest-deep sm:text-5xl">{t.title}</h2>
      <p class="mt-4 text-lg leading-relaxed text-ink-soft">{t.lead}</p>
    </div>

    <div data-anim="stagger" class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {hospedajes.map((h) => (
        <a
          href={h.href}
          class:list={[
            "group relative flex min-h-[22rem] flex-col justify-end overflow-hidden rounded-2xl bg-forest-deep text-cream shadow-soft",
            h.featured && "md:col-span-2 lg:min-h-[26rem]",
          ]}
        >
          <OptImage
            src={h.image}
            alt={h.alt}
            maxWidth={h.featured ? 1400 : 900}
            class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-forest-deep from-15% via-forest-deep/80 via-45% to-forest-deep/0 to-80%"></div>
          <div class="relative p-6 [text-shadow:0_1px_10px_rgba(10,20,14,0.5)] sm:p-8">
            <span class="mb-3 inline-block rounded-full bg-cream px-3 py-1 text-xs font-semibold text-forest-deep [text-shadow:none]">{h.tag}</span>
            <h3 class="font-display text-2xl sm:text-3xl">{h.name}</h3>
            <p class="mt-2 max-w-md text-sm leading-relaxed text-cream/90 sm:text-base">{h.text}</p>
            <span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-gold-light">
              {t.cta}
              <svg aria-hidden="true" class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
            </span>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-10 text-center">
      <a href={en ? "/en/vacacionales" : "/vacacionales"} class="inline-flex items-center gap-2 font-semibold text-forest underline-offset-4 hover:underline">
        {t.all} →
      </a>
    </div>
  </div>
</section>
