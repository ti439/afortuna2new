---
import OptImage from "../OptImage.astro";
import entrada from "../../assets/bg-gd.jpg";
import CTA from "./CTA.astro";
import Vapor from "./Vapor.astro";
import { oferta } from "../../lib/oferta";

const { texto, mapaEmbed, mapaLink } = oferta.ubicacion;
---

<section id="ubicacion" class="bg-[#f8f3e7]">
  <div class="mx-auto max-w-5xl px-4 py-16 sm:px-8 md:py-24">
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-[#256b4c]">Ubicación</p>
    <h2 class="mt-3 max-w-2xl font-display text-[2.1rem] font-semibold leading-[1.05] text-[#0d2620] sm:text-5xl">
      En La Fortuna, <em class="font-normal text-[#9a6b1c]">con el Arenal de vecino.</em>
    </h2>
    <Vapor class="mt-5 text-[#d9a74a]" />
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-[#3d4a44]">{texto}</p>

    <div class="mt-10 grid gap-4 md:grid-cols-2">
      <OptImage
        src={entrada}
        alt="Volcán Arenal visto desde la entrada del Hotel Sueño Dorado"
        maxWidth={800}
        widths={[420, 800]}
        sizes="(min-width: 768px) 480px, calc(100vw - 32px)"
        quality={65}
        class="aspect-[4/3] w-full rounded-2xl object-cover"
      />
      <!-- Google Maps pesa ~1 MB: se carga solo si la persona lo pide -->
      <div id="mapa" class="relative aspect-[4/3] w-full overflow-hidden rounded-2xl bg-[#e4dcc8] bg-[radial-gradient(#0d2620_1px,transparent_1px)] [background-size:18px_18px]">
        <button
          type="button"
          data-mapa={mapaEmbed}
          class="absolute inset-0 flex flex-col items-center justify-center gap-3 bg-[#e4dcc8]/70 text-[#0d2620] transition-colors hover:bg-[#e4dcc8]/50"
        >
          <span class="grid h-16 w-16 place-items-center rounded-full bg-[#0d2620] text-[#f1d590] shadow-lg">
            <svg aria-hidden="true" viewBox="0 0 24 24" class="h-8 w-8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z" /><circle cx="12" cy="9.5" r="2.5" /></svg>
          </span>
          <span class="rounded-full bg-white px-5 py-2.5 font-bold shadow-sm">Ver mapa aquí</span>
          <span class="text-sm font-semibold text-[#3d4a44]">Hotel Sueño Dorado · La Fortuna</span>
        </button>
      </div>
    </div>

    <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
      <CTA label="Consultar por WhatsApp" origen="ubicacion" />
      <a
        href={mapaLink}
        target="_blank"
        rel="noopener noreferrer"
        data-cta="abrir-ubicacion"
        data-track-only
        class="inline-flex min-h-[56px] items-center justify-center gap-2 rounded-full border-2 border-[#0d2620] px-7 font-bold text-[#0d2620] transition-colors hover:bg-[#0d2620] hover:text-white"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z" /><circle cx="12" cy="9.5" r="2.5" /></svg>
        Abrir ubicación
      </a>
    </div>
  </div>
</section>

<script>
  const boton = document.querySelector<HTMLButtonElement>("#mapa [data-mapa]");
  boton?.addEventListener("click", () => {
    const iframe = document.createElement("iframe");
    iframe.src = boton.dataset.mapa!;
    iframe.title = "Mapa del Hotel Sueño Dorado en La Fortuna";
    iframe.referrerPolicy = "no-referrer-when-downgrade";
    iframe.className = "absolute inset-0 h-full w-full border-0";
    boton.replaceWith(iframe);
    iframe.focus();
  });
</script>
