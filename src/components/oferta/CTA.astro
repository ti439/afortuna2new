---
// Botón de WhatsApp de la landing. `origen` identifica la sección en GA4 (evento cta_click).
// Dorado de marca con el ícono de WhatsApp en su círculo verde, para que se reconozca al instante.
import { waLink } from "../../lib/oferta";

interface Props {
  label: string;
  origen: string;
  variant?: "primary" | "link";
  class?: string;
}

const { label, origen, variant = "primary", class: extra = "" } = Astro.props;
---

{variant === "link" ? (
  <a href={waLink} target="_blank" rel="noopener noreferrer" data-cta={origen}
     class:list={["inline-flex min-h-[44px] items-center gap-1 font-semibold underline decoration-[#d9a74a] decoration-2 underline-offset-[6px]", extra]}>
    {label}
  </a>
) : (
  <a href={waLink} target="_blank" rel="noopener noreferrer" data-cta={origen}
     class:list={["cta-oro group inline-flex min-h-[56px] items-center justify-center gap-3 rounded-full py-2 pl-2 pr-7 text-base font-bold text-[#1b1406] sm:text-lg", extra]}>
    <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-[#1f8a4c] text-white transition-transform group-hover:scale-105">
      <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor">
        <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91C21.95 6.45 17.5 2 12.04 2Zm5.8 14.13c-.24.68-1.42 1.3-1.96 1.36-.5.06-1.13.08-1.82-.11-.42-.13-.96-.31-1.65-.61-2.9-1.25-4.8-4.18-4.94-4.37-.14-.19-1.18-1.57-1.18-3 0-1.42.75-2.12 1.01-2.41.27-.29.58-.36.78-.36h.56c.18 0 .42-.07.66.5.24.58.82 2 .89 2.15.07.14.12.31.02.5-.1.19-.14.31-.29.48-.14.17-.3.38-.43.5-.14.14-.29.3-.13.59.17.29.74 1.22 1.59 1.98 1.09.97 2.01 1.27 2.3 1.42.29.14.46.12.63-.07.17-.19.72-.84.92-1.13.19-.29.38-.24.65-.14.26.1 1.68.79 1.97.94.29.14.48.22.55.34.07.12.07.7-.17 1.38Z" />
      </svg>
    </span>
    <span>{label}</span>
  </a>
)}
