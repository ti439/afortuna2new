---
import { oferta } from "../../lib/oferta";

// Iconos de trazo simples, en el mismo orden que oferta.beneficios
const iconos = [
  '<path d="M4 9h12v5a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5V9Z"/><path d="M16 11h1.5a2.5 2.5 0 0 1 0 5H16"/><path d="M8 3v3M12 3v3"/>',
  '<path d="M3 17c1.5 0 1.5 1 3 1s1.5-1 3-1 1.5 1 3 1 1.5-1 3-1 1.5 1 3 1 1.5-1 3-1"/><path d="M8 4c-1 1.5 1 2.5 0 4M12 4c-1 1.5 1 2.5 0 4M16 4c-1 1.5 1 2.5 0 4"/><path d="M5 13h14"/>',
  '<rect x="4" y="3" width="16" height="18" rx="3"/><path d="M10 16V8h3a2.5 2.5 0 0 1 0 5h-3"/>',
  '<path d="M2.5 9a14 14 0 0 1 19 0"/><path d="M5.5 12.5a9.5 9.5 0 0 1 13 0"/><path d="M8.5 16a5 5 0 0 1 7 0"/><circle cx="12" cy="19" r="1"/>',
  '<path d="M2 20h20L15 9h-6L2 20Z"/><path d="M9 9l1.5 2.5L12 10l1.5 1.5L15 9"/><path d="M11 6c0-1.5 2-1.5 2-3"/>',
];
---

<section aria-label="Beneficios incluidos" class="border-y border-white/10 bg-[#0d2620] text-white">
  <ul class="mx-auto grid max-w-5xl grid-cols-2 gap-x-4 gap-y-4 px-4 py-6 sm:grid-cols-5 sm:px-8">
    {oferta.beneficios.map((b, i) => (
      <li class:list={["flex items-center gap-3 text-sm font-semibold sm:justify-center", i === 4 && "col-span-2 justify-center sm:col-span-1"]}>
        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-6 w-6 shrink-0 text-[#d9a74a]" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={iconos[i]} />
        <span>{b}</span>
      </li>
    ))}
  </ul>
</section>
