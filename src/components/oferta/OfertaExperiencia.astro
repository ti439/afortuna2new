---
// "Tu noche dorada": la estadía contada como momentos, de la llegada al desayuno.
import OptImage from "../OptImage.astro";
import CTA from "./CTA.astro";
import Vapor from "./Vapor.astro";
import { oferta } from "../../lib/oferta";
import { resolveImage } from "../../lib/images";

const momentos = oferta.momentos.map((m) => ({ ...m, src: resolveImage(m.img) }));
---

<section class="bg-[#f8f3e7]">
  <div class="mx-auto max-w-5xl px-4 py-16 sm:px-8 md:py-24">
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-[#256b4c]">Tu noche dorada</p>
    <h2 class="mt-3 max-w-2xl font-display text-[2.1rem] font-semibold leading-[1.05] text-[#0d2620] sm:text-5xl">
      Menos correr. <em class="font-normal text-[#9a6b1c]">Más tiempo para descansar.</em>
    </h2>
    <Vapor class="mt-5 text-[#d9a74a]" />
    <p class="mt-5 max-w-xl text-lg leading-relaxed text-[#3d4a44]">
      Todo pasa dentro del hotel: termales, jardines y desayuno. Vos solo llegás.
    </p>

    <ol class="relative mt-10 grid gap-8 md:grid-cols-4 md:gap-5">
      {momentos.map((m, i) => (
        <li class="relative grid grid-cols-[88px_1fr] items-start gap-4 md:block">
          <div class="relative">
            <OptImage src={m.src} alt={m.alt} maxWidth={480} widths={[176, 320, 480]} sizes="(min-width: 768px) 220px, 88px" quality={65} class="aspect-square w-full rounded-2xl object-cover md:aspect-[4/5]" />
            <span class="absolute -left-2 -top-2 grid h-8 w-8 place-items-center rounded-full bg-[#0d2620] font-display text-sm font-semibold text-[#f1d590] ring-4 ring-[#f8f3e7]">{i + 1}</span>
          </div>
          <div class="md:mt-4">
            <h3 class="font-display text-xl font-semibold text-[#0d2620]">{m.titulo}</h3>
            <p class="mt-1 leading-relaxed text-[#3d4a44]">{m.texto}</p>
          </div>
        </li>
      ))}
    </ol>

    <CTA label="Quiero revisar fechas" origen="experiencia" class="mt-12 w-full sm:w-auto" />
  </div>
</section>
