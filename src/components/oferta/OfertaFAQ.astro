---
// Cómo reservar en 3 pasos + preguntas frecuentes: quita la fricción antes de escribir.
import CTA from "./CTA.astro";
import { oferta, faqPublicadas } from "../../lib/oferta";
---

<section id="faq" class="bg-[#efe6d2]">
  <div class="mx-auto max-w-5xl px-4 py-16 sm:px-8 md:py-24">
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-[#256b4c]">Así de fácil</p>
    <h2 class="mt-3 font-display text-[2.1rem] font-semibold leading-[1.05] text-[#0d2620] sm:text-5xl">
      Reservar te toma <em class="font-normal text-[#9a6b1c]">un mensaje.</em>
    </h2>

    <ol class="mt-10 grid gap-4 md:grid-cols-3">
      {oferta.pasos.map((p, i) => (
        <li class="flex gap-4 rounded-2xl bg-white p-5 md:block md:p-6">
          <span class="font-display text-4xl font-semibold leading-none text-[#d9a74a] md:text-5xl">{i + 1}</span>
          <div class="md:mt-3">
            <h3 class="text-lg font-bold text-[#18231f]">{p.titulo}</h3>
            <p class="mt-1 leading-relaxed text-[#3d4a44]">{p.texto}</p>
          </div>
        </li>
      ))}
    </ol>

    <div class="mt-16 grid gap-8 md:grid-cols-[1fr_1.6fr] md:gap-12">
      <h3 class="font-display text-3xl font-semibold leading-tight text-[#0d2620]">Preguntas frecuentes</h3>
      <div class="divide-y divide-[#0d2620]/10 rounded-2xl bg-white">
        {faqPublicadas.map((f) => (
          <details class="group px-5">
            <summary class="flex min-h-[60px] cursor-pointer list-none items-center justify-between gap-4 py-4 font-semibold text-[#18231f] [&::-webkit-details-marker]:hidden">
              {f.pregunta}
              <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-[#0d2620] text-[#f1d590] transition-transform group-open:rotate-45">
                <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
              </span>
            </summary>
            <p class="pb-5 leading-relaxed text-[#3d4a44]">{f.respuesta}</p>
          </details>
        ))}
      </div>
    </div>

    <CTA label="Ya sé lo que necesito – revisar fecha" origen="faq" class="mt-12 w-full sm:w-auto" />
  </div>
</section>
