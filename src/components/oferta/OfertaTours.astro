---
// Tours con tarifa nacional como complemento de la estadía (no compite con la oferta principal).
import CTA from "./CTA.astro";
import Vapor from "./Vapor.astro";
import { oferta } from "../../lib/oferta";

const { nota, items, combo } = oferta.tours;
---

<section id="tours" class="bg-white">
  <div class="mx-auto max-w-5xl px-4 py-16 sm:px-8 md:py-24">
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-[#256b4c]">{nota}</p>
    <h2 class="mt-3 max-w-2xl font-display text-[2.1rem] font-semibold leading-[1.05] text-[#0d2620] sm:text-5xl">
      ¿Venís por más? <em class="font-normal text-[#9a6b1c]">Sumale aventura.</em>
    </h2>
    <Vapor class="mt-5 text-[#d9a74a]" />
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-[#3d4a44]">
      Precios especiales para nacionales. Te lo cotizamos junto con tu noche en el mismo WhatsApp.
    </p>

    <ul class="mt-10 grid gap-3 sm:grid-cols-2">
      {items.map((t) => (
        <li class="flex items-center justify-between gap-4 rounded-2xl border border-[#0d2620]/10 bg-[#f8f3e7] p-5">
          <div>
            <h3 class="text-lg font-bold text-[#18231f]">{t.nombre}</h3>
            <p class="mt-0.5 text-sm text-[#3d4a44]">{t.detalle}</p>
            <p class="mt-2 text-xs font-semibold uppercase tracking-wide text-[#5b6a63]">Salidas: {t.salidas}</p>
          </div>
          <p class="shrink-0 text-right">
            <span class="block text-xs text-[#5b6a63]">por persona</span>
            <span class="font-display text-2xl font-semibold text-[#0d2620]">{t.precio}</span>
          </p>
        </li>
      ))}
    </ul>

    <p class="mt-5 rounded-xl bg-[#0d2620] px-5 py-4 text-white">
      <strong class="text-[#f1d590]">Combiná y ahorrá:</strong> {combo}
    </p>

    <CTA label="Cotizar noche + tour" origen="tours" class="mt-10 w-full sm:w-auto" />
  </div>
</section>
