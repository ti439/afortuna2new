---
import { getImage } from "astro:assets";
import termales from "../../assets/termales.JPG";
import termalesMovil from "../../assets/termales-movil.jpg";
import CTA from "./CTA.astro";
import Luna from "./Luna.astro";
import { oferta } from "../../lib/oferta";

const { eyebrow, porPersona, sabado, vigencia } = oferta.oferta;

// Imagen LCP con dirección de arte: recorte vertical en celular (no se estira ni se pixela),
// panorámica en tablet/escritorio. Calidad 50: va debajo de un degradado oscuro.
const movil = await getImage({ src: termalesMovil, widths: [480, 675], format: "webp", quality: 50 });
const ancha = await getImage({ src: termales, widths: [1024, 1440, 1920], format: "webp", quality: 60 });
---

<section id="hero" class="grano relative isolate flex min-h-[92svh] flex-col overflow-hidden bg-[#0d2620] text-white">
  <picture>
    <source media="(max-width: 767px)" srcset={movil.srcSet.attribute} sizes="100vw" width="675" height="1350" />
    <img
      src={ancha.src}
      srcset={ancha.srcSet.attribute}
      sizes="100vw"
      width="2400"
      height="1350"
      alt="Vista aérea de las piscinas termales y jardines del Hotel Sueño Dorado en La Fortuna"
      fetchpriority="high"
      class="absolute inset-0 -z-20 h-full w-full object-cover"
    />
  </picture>
  <!-- Noche termal: verde profundo abajo, un brillo dorado arriba -->
  <div class="absolute inset-0 -z-10 bg-[linear-gradient(to_top,#0d2620_8%,rgba(13,38,32,.82)_38%,rgba(13,38,32,.25)_72%,rgba(13,38,32,.55))]"></div>
  <div class="absolute -right-24 -top-24 -z-10 h-72 w-72 rounded-full bg-[#d9a74a]/25 blur-3xl"></div>

  <header class="mx-auto flex w-full max-w-5xl items-center justify-between px-4 pt-5 sm:px-8">
    <!-- Logotipo en vectores (el PNG trae fondo blanco): luna + nombre en el verde del logo -->
    <p class="flex items-center gap-2.5 text-[#79c39f]">
      <Luna class="h-9 w-9" />
      <span class="leading-none">
        <span class="block font-display text-lg font-medium tracking-[0.12em]">SUEÑO DORADO</span>
        <span class="mt-1 block text-[0.6rem] font-semibold tracking-[0.24em] text-[#79c39f]/85">HOTEL & HOT SPRINGS</span>
      </span>
    </p>
    <span class="hidden rounded-full border border-white/25 px-3 py-1 text-xs font-semibold uppercase tracking-[0.16em] text-white/85 sm:inline">Reserva directa</span>
  </header>

  <div class="mx-auto mt-auto w-full max-w-5xl px-4 pb-9 pt-10 sm:px-8 sm:pb-16">
    <p class="flex items-center gap-2 text-[0.8rem] font-semibold uppercase tracking-[0.2em] text-[#a8dcc2]">
      <Luna class="h-4 w-4" /> {eyebrow}
    </p>

    <h1 class="mt-3 font-display font-semibold leading-[0.95]">
      <span class="block text-[2.15rem] sm:text-6xl">La Fortuna para 2</span>{" "}
      <span class="mt-1 flex items-baseline gap-3">
        <em class="font-normal text-[1.7rem] text-white/80 sm:text-4xl">desde</em>{" "}
        <span class="precio-oro text-[3.6rem] tracking-tight sm:text-[6.5rem]">₡49.900</span>
      </span>
    </h1>

    <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-base font-semibold text-white sm:text-xl" aria-label="Desayuno + aguas termales + IVA incluido">
      <li class="flex items-center gap-1.5"><span aria-hidden="true" class="text-[#67b08d]">✓</span>Desayuno</li>
      <li class="flex items-center gap-1.5"><span aria-hidden="true" class="text-[#67b08d]">✓</span>Aguas termales</li>
      <li class="flex items-center gap-1.5"><span aria-hidden="true" class="text-[#67b08d]">✓</span>IVA incluido</li>
    </ul>

    <p class="mt-3 inline-flex items-center rounded-full bg-white/10 px-3 py-1 text-sm text-white/90 ring-1 ring-white/15 backdrop-blur">
      Sale a {porPersona} · por noche
    </p>

    <div class="mt-6 flex flex-col items-stretch gap-2 sm:flex-row sm:items-center sm:gap-6">
      <CTA label="Ver disponibilidad" origen="hero" class="w-full sm:w-auto" />
      <CTA label="Reservar por WhatsApp" origen="hero-link" variant="link" class="self-start text-white/90 hover:text-white" />
    </div>

    <p class="mt-4 text-[0.8rem] leading-snug text-white/65">Tarifa “desde” por noche para 2 personas. {sabado} {vigencia} Precio final según fecha y disponibilidad.</p>
  </div>
</section>
