---
import OptImage from "../OptImage.astro";
const heroBgUrl = "https://i.ibb.co/zWDQKjrm/fuera.jpg";
const useBackgroundImage = true;
---

<section class="relative flex h-screen items-center overflow-hidden bg-[#2f4b2c] text-[#f3eee7]">
  {useBackgroundImage && (
    <>
      <OptImage src={heroBgUrl} alt="" maxWidth={1920} loading="eager" fetchpriority="high" class="absolute inset-0 h-full w-full object-cover" />
      <div class="absolute inset-0 bg-black/50"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(0,0,0,0.55)_0%,transparent_70%)]"></div>
    </>
  )}
  <div class="relative z-10 w-full flex flex-col items-center text-center [text-shadow:0_2px_18px_rgba(0,0,0,0.6)] px-6 sm:px-8 max-w-5xl mx-auto space-y-8">
    <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold leading-tight">
      Sabor tico, tradición viva y descanso con alma
    </h1>
    <p class="text-lg sm:text-xl md:text-2xl font-medium text-[#ebe4da]">
      Hay lugares que no solo se visitan... se sienten como hogar
    </p>
    <a
      href="https://us2.cloudbeds.com/reservation/brsfX9"
      onclick="return gtagSendEvent(this.href, this.target)"
      class="inline-block bg-[#e6ddd2] text-[#2f4b2c] font-semibold text-lg sm:text-xl py-3 px-8 rounded-md shadow transition duration-300 hover:-translate-y-0.5 hover:shadow-lg"
    >
      Reservá tu experiencia
    </a>
  </div>
</section>
